# CIMPLE — Firebase config (Increment D)
# Copy to .env.local for local dev, and set the same keys in Vercel
# (Project → Settings → Environment Variables) to go live.
#
# Until ALL of API_KEY, AUTH_DOMAIN, PROJECT_ID and APP_ID are set,
# CIMPLE runs in LOCAL MODE (localStorage only, no sign-in) — unchanged.
#
# Get these from: Firebase console → Project settings → General →
# "Your apps" → Web app → SDK setup and configuration → Config.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
