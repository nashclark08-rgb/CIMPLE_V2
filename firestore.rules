rules_version = '2';

// CIMPLE — Firestore security rules.
//
// Starting posture: this is a PRIVATE tool for the TAC Critical Incident
// Management Team. Only signed-in users can read or write anything; the
// public gets nothing. This is deliberately simple for the first connected
// build — role-based rules (who may edit which incident) come with the RBAC
// work once the data model is migrated and real accounts exist.
service cloud.firestore {
  match /databases/{database}/documents {

    // Any authenticated CIMT member may read/write incident + roster data.
    // Unauthenticated requests are denied by default (no matching allow).
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
